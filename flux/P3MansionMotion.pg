// Generated by modeling/p3_gimmicks/build_content.py (W10-B, G05 and G06). Do not edit by hand.
// Local presentation: every user evaluates the output Drives from the shared WorldTimeDouble and the
// HMC_P3 dynamic variables. No impulses and no synchronized writes.
module P3MansionMotion
out G1Position: float3
out G1Rotation: floatQ
out G2Position: float3
out G2Rotation: floatQ
out D1Rotation: floatQ
out D2Rotation: floatQ
where {
    T = WorldTimeDouble;
    G05IntensityIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G05Intensity");
    G05FrequencyIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G05Frequency");
    G05SpreadIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G05PhaseSpread");
    G06IntensityIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G06Intensity");
    G06FrequencyIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G06Frequency");
    G06PhaseIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G06Phase");
    // A missing variable reads as 0, which keeps the ghosts at their rest pose and the doors closed.
    // G05: floating ghosts (lift along Y, sway about Y at half the speed)
    GI = Clamp01_Float(G05IntensityIn.Value);
    GF0 = G05FrequencyIn.Value;
    GF = if GF0 < 0.0 then 0.0 else if GF0 > 1.0 then 1.0 else GF0;
    GS = Clamp01_Float(G05SpreadIn.Value);
    GBase = T * (GF->as<double>) * 6.283185307179586d;
    GSd = GS->as<double>;
    // BMN_FloatingGhost_001: phase 0.0 deg, lift -0.1..0.35 m, sway +-20.0 deg
    GTh1 = GBase + GSd * 0.0d;
    GLift1 = GI * (0.12499999999999999 + 0.22499999999999998 * (Sin_Double(GTh1)->as<float>));
    GYaw1 = GI * 20.0 * (Sin_Double(GTh1 * 0.5d)->as<float>);
    G1Position = Pack_Float3(7.152557373046875e-07, -2.384185791015625e-07 + GLift1, 7.152557373046875e-07);
    G1Rotation = FromEuler_floatQ(Pack_Float3(0.0, 0.0 - GYaw1, 0.0));
    // BMN_FloatingGhost_002: phase 180.0 deg, lift -0.1..0.35 m, sway +-20.0 deg
    GTh2 = GBase + GSd * 3.141592653589793d;
    GLift2 = GI * (0.12499999999999999 + 0.22499999999999998 * (Sin_Double(GTh2)->as<float>));
    GYaw2 = GI * 20.0 * (Sin_Double(GTh2 * 0.5d)->as<float>);
    G2Position = Pack_Float3(-4.76837158203125e-07, -2.384185791015625e-07 + GLift2, -9.5367431640625e-07);
    G2Rotation = FromEuler_floatQ(Pack_Float3(0.0, 0.0 - GYaw2, 0.0));
    // G06: double door (closed, opening, open, closing), smoothstep between the holds
    DI = Clamp01_Float(G06IntensityIn.Value);
    DF0 = G06FrequencyIn.Value;
    DF = if DF0 < 0.0 then 0.0 else if DF0 > 0.2 then 0.2 else DF0;
    DP = Clamp01_Float(G06PhaseIn.Value);
    DTh = (T * (DF->as<double>) + (DP->as<double>)) * 6.283185307179586d;
    DC = 0.5 - 0.5 * (Cos_Double(DTh)->as<float>);
    DX = Clamp01_Float((DC - 0.25) * 2.0);
    DOpen = DX * DX * (3.0 - 2.0 * DX);
    DAng = DI * 85.0 * DOpen;
    // BMN_MansionDoubleDoor_001_HingeLeft: opens +Z in Blender (inward)
    D1Rotation = FromEuler_floatQ(Pack_Float3(0.0, 0.0 - DAng, 0.0));
    // BMN_MansionDoubleDoor_001_HingeRight: opens -Z in Blender (inward)
    D2Rotation = FromEuler_floatQ(Pack_Float3(0.0, DAng, 0.0));
}
