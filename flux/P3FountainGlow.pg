// Generated by modeling/p3_gimmicks/build_content.py (W10-A, G03). Do not edit by hand.
// Local presentation: every user evaluates the output Drive from the shared WorldTimeDouble and the
// HMC_P3 dynamic variables. No impulses and no synchronized writes.
// E0 (P2 water glow, linear) = (0.504, 0.99, 1.764), E1 (violet, linear) = (1.2, 0.4, 2.0)
module P3FountainGlow
out WaterEmissive: colorX
where {
    T = WorldTimeDouble;
    IntensityIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G03Intensity");
    FrequencyIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G03Frequency");
    SwingIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G03Swing");
    // A missing variable reads as 0: intensity 0 turns the water glow off.
    I0 = IntensityIn.Value;
    I = if I0 < 0.0 then 0.0 else if I0 > 2.0 then 2.0 else I0;
    F0 = FrequencyIn.Value;
    F = if F0 < 0.0 then 0.0 else if F0 > 1.0 then 1.0 else F0;
    A0 = SwingIn.Value;
    A = if A0 < 0.0 then 0.0 else if A0 > 1.0 then 1.0 else A0;
    Th = T * (F->as<double>) * 6.283185307179586d;
    Pulse = 1.0 + 0.5 * A * (Sin_Double(Th)->as<float>);
    Mix = A * (0.5 - 0.5 * (Cos_Double(Th * 0.5d)->as<float>));
    K = I * Pulse;
    R = K * (0.504 + Mix * 0.696);
    G = K * (0.99 + Mix * -0.59);
    B = K * (1.764 + Mix * 0.236);
    WaterEmissive = Pack_ColorX(R, G, B, 1.0, ColorProfile.Linear);
}
