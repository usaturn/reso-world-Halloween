    // DAM_GhostTrain_001_CarWheelRear_001: radius 0.2 m, rolls about +X
    W2H = Dist * 2.5d;
    W2Rotation = Pack_FloatQ(Sin_Double(W2H)->as<float>, 0.0, 0.0, Cos_Double(W2H)->as<float>);
    // DAM_GhostTrain_001_EngineWheelFront: radius 0.21 m, rolls about +X
    W3H = Dist * 2.380952380952381d;
    W3Rotation = Pack_FloatQ(Sin_Double(W3H)->as<float>, 0.0, 0.0, Cos_Double(W3H)->as<float>);
