    V0 = SpeedIn.Value;
    V = if V0 < 0.0 then 0.0 else if V0 > 3.0 then 3.0 else V0;
    P = Clamp01_Float(PhaseIn.Value);
    // Distance travelled from the rest pose (m). The wheels turn by Dist / radius, so they never jump at the loop seam.
    Dist = T * (V->as<double>) + (P->as<double>) * 36.27433388230814d;
    // DAM_GhostTrain_001_EngineRoot: rest arc 3.0 m
