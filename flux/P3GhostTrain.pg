    EB1 = 3.141592653589793d * Clamp01_Double((EU - 4.0d) * 0.0707355302630646d);
    ED2 = 4.0d * Clamp01_Double((EU - 18.13716694115407d) * 0.25d);
    EB2 = 3.141592653589793d * Clamp01_Double((EU - 22.13716694115407d) * 0.0707355302630646d);
    EX = 0.0d - 4.5d * Cos_Double(EB1) + 4.5d * Cos_Double(EB2);
    EY = -2.0d + ED1 + 4.5d * Sin_Double(EB1) - ED2 - 4.5d * Sin_Double(EB2);
