    // DAM_GhostTrain_001_CarRoot_001: rest arc 0.25 m
    CU = 36.27433388230814d * Repeat01_Double((Dist + 0.25d) * 0.027567701263502012d);
    CD1 = 4.0d * Clamp01_Double(CU * 0.25d);
    CB1 = 3.141592653589793d * Clamp01_Double((CU - 4.0d) * 0.0707355302630646d);
    CD2 = 4.0d * Clamp01_Double((CU - 18.13716694115407d) * 0.25d);
    CB2 = 3.141592653589793d * Clamp01_Double((CU - 22.13716694115407d) * 0.0707355302630646d);
    CX = 0.0d - 4.5d * Cos_Double(CB1) + 4.5d * Cos_Double(CB2);
    CY = -2.0d + CD1 + 4.5d * Sin_Double(CB1) - CD2 - 4.5d * Sin_Double(CB2);
    CH = (CB1 + CB2) * 0.5d;
    CarPosition = Pack_Float3(CX->as<float>, 0.14000000059604645, CY->as<float>);
    CarRotation = Pack_FloatQ(0.0, Sin_Double(CH)->as<float>, 0.0, Cos_Double(CH)->as<float>);
