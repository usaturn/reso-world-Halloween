// Generated by modeling/p3_gimmicks/build_content.py (W10-E, G18 and G20). Do not edit by hand.
// Local presentation: every user evaluates the output Drives. G18 uses the shared WorldTimeDouble, G20 uses the
// viewer's own local clock (ToLocalTime(UtcNow), the 2026-11-03 decision). No impulses and no synchronized writes.
// E0 (P2 mushroom glow, linear) = (1.536, 2.752, 3.2)
module P3ForestClock
out M01Emissive: colorX
out M02Emissive: colorX
out M03Emissive: colorX
out M04Emissive: colorX
out M05Emissive: colorX
out M06Emissive: colorX
out M07Emissive: colorX
out M08Emissive: colorX
out M09Emissive: colorX
out M10Emissive: colorX
out M11Emissive: colorX
out M12Emissive: colorX
out M13Emissive: colorX
out M14Emissive: colorX
out HourRotation: floatQ
out MinuteRotation: floatQ
out BellRotation: floatQ
out Clock1: double2
out Clock2: double2
where {
    T = WorldTimeDouble;
    IntensityIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G18Intensity");
    SpeedIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G18Speed");
    SwingIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G20BellSwing");
    IntervalIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G20BellInterval");
    // A missing variable reads as 0: the mushrooms go dark and the bell stays still (the interval clamps to its minimum).
    I0 = IntensityIn.Value;
    I = if I0 < 0.0 then 0.0 else if I0 > 2.0 then 2.0 else I0;
    S0 = SpeedIn.Value;
    S = if S0 < 0.0 then 0.0 else if S0 > 3.0 then 3.0 else S0;
    St = T * (S->as<double>);
    // EFR_MushroomTall_001: period 3.2 s, phase 0.0 s, intensity 0.35..1.0
    Th01 = (St + 0.0d) * 1.9634954084936207d;
    K01 = I * (0.675 + 0.325 * (Sin_Double(Th01)->as<float>));
    M01Emissive = Pack_ColorX(K01 * 1.536, K01 * 2.752, K01 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomTall_002: period 4.03 s, phase 1.37 s, intensity 0.35..1.0
    Th02 = (St + 1.37d) * 1.559103053890716d;
    K02 = I * (0.675 + 0.325 * (Sin_Double(Th02)->as<float>));
    M02Emissive = Pack_ColorX(K02 * 1.536, K02 * 2.752, K02 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomTall_003: period 4.86 s, phase 2.74 s, intensity 0.35..1.0
    Th03 = (St + 2.74d) * 1.2928364829587624d;
    K03 = I * (0.675 + 0.325 * (Sin_Double(Th03)->as<float>));
    M03Emissive = Pack_ColorX(K03 * 1.536, K03 * 2.752, K03 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomTall_004: period 5.69 s, phase 4.11 s, intensity 0.35..1.0
    Th04 = (St + 4.11d) * 1.1042504933531785d;
    K04 = I * (0.675 + 0.325 * (Sin_Double(Th04)->as<float>));
    M04Emissive = Pack_ColorX(K04 * 1.536, K04 * 2.752, K04 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomTall_005: period 6.52 s, phase 5.48 s, intensity 0.35..1.0
    Th05 = (St + 5.48d) * 0.9636787280950286d;
    K05 = I * (0.675 + 0.325 * (Sin_Double(Th05)->as<float>));
    M05Emissive = Pack_ColorX(K05 * 1.536, K05 * 2.752, K05 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomMedium_001: period 3.95 s, phase 2.9 s, intensity 0.35..1.0
    Th06 = (St + 2.9d) * 1.5906798246024267d;
    K06 = I * (0.675 + 0.325 * (Sin_Double(Th06)->as<float>));
    M06Emissive = Pack_ColorX(K06 * 1.536, K06 * 2.752, K06 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomMedium_002: period 4.78 s, phase 3.44 s, intensity 0.35..1.0
    Th07 = (St + 3.44d) * 1.3144739136358967d;
    K07 = I * (0.675 + 0.325 * (Sin_Double(Th07)->as<float>));
    M07Emissive = Pack_ColorX(K07 * 1.536, K07 * 2.752, K07 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomMedium_003: period 5.61 s, phase 3.98 s, intensity 0.35..1.0
    Th08 = (St + 3.98d) * 1.1199973809589279d;
    K08 = I * (0.675 + 0.325 * (Sin_Double(Th08)->as<float>));
    M08Emissive = Pack_ColorX(K08 * 1.536, K08 * 2.752, K08 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomCluster_001: period 6.44 s, phase 4.52 s, intensity 0.35..1.0
    Th09 = (St + 4.52d) * 0.9756498924191903d;
    K09 = I * (0.675 + 0.325 * (Sin_Double(Th09)->as<float>));
    M09Emissive = Pack_ColorX(K09 * 1.536, K09 * 2.752, K09 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomCluster_002: period 3.87 s, phase 0.72 s, intensity 0.35..1.0
    Th10 = (St + 0.72d) * 1.623562094878446d;
    K10 = I * (0.675 + 0.325 * (Sin_Double(Th10)->as<float>));
    M10Emissive = Pack_ColorX(K10 * 1.536, K10 * 2.752, K10 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomCluster_004: period 4.7 s, phase 4.3 s, intensity 0.35..1.0
    Th11 = (St + 4.3d) * 1.3368479376977842d;
    K11 = I * (0.675 + 0.325 * (Sin_Double(Th11)->as<float>));
    M11Emissive = Pack_ColorX(K11 * 1.536, K11 * 2.752, K11 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomCluster_006: period 5.53 s, phase 4.01 s, intensity 0.35..1.0
    Th12 = (St + 4.01d) * 1.1361998747160191d;
    K12 = I * (0.675 + 0.325 * (Sin_Double(Th12)->as<float>));
    M12Emissive = Pack_ColorX(K12 * 1.536, K12 * 2.752, K12 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomCluster_008: period 6.36 s, phase 3.72 s, intensity 0.35..1.0
    Th13 = (St + 3.72d) * 0.9879222181099978d;
    K13 = I * (0.675 + 0.325 * (Sin_Double(Th13)->as<float>));
    M13Emissive = Pack_ColorX(K13 * 1.536, K13 * 2.752, K13 * 3.2, 1.0, ColorProfile.Linear);
    // EFR_MushroomGiant_001: period 3.79 s, phase 2.65 s, intensity 0.35..1.0
    Th14 = (St + 2.65d) * 1.6578325348758802d;
    K14 = I * (0.675 + 0.325 * (Sin_Double(Th14)->as<float>));
    M14Emissive = Pack_ColorX(K14 * 1.536, K14 * 2.752, K14 * 3.2, 1.0, ColorProfile.Linear);
    // G20: the viewer's local time of day (s)
    L = ToLocalTime(UtcNow);
    Sod = (DateTimeHour(L)->as<double>) * 3600.0d + (DateTimeMinute(L)->as<double>) * 60.0d + (DateTimeSecond(L)->as<double>) + (DateTimeMillisecond(L)->as<double>) * 0.001d;
    // Hands: clockwise seen from the front = positive about the pivot's local +Z (half angles for the quaternion)
    HourH = Repeat01_Double(Sod * 2.3148148148148147e-05d) * 3.141592653589793d;
    MinuteH = Repeat01_Double(Sod * 0.0002777777777777778d) * 3.141592653589793d;
    HourRotation = Pack_FloatQ(0.0, 0.0, Sin_Double(HourH)->as<float>, Cos_Double(HourH)->as<float>);
    MinuteRotation = Pack_FloatQ(0.0, 0.0, Sin_Double(MinuteH)->as<float>, Cos_Double(MinuteH)->as<float>);
    // Bell: swings for a fixed time after each mark (a multiple of the interval since local midnight), then hangs still
    W = Clamp01_Float(SwingIn.Value);
    N0 = IntervalIn.Value;
    N = (if N0 < 20.0 then 20.0 else if N0 > 3600.0 then 3600.0 else N0)->as<double>;
    Tau = Repeat01_Double(Sod / N) * N;
    X = Clamp01_Double(Tau * 0.08333333333333333d);
    BellH = (W->as<double>) * 0.2181661564992912d * (1.0d - X) * (1.0d - X) * Sin_Double(X * 37.69911184307752d);
    BellRotation = Pack_FloatQ(Sin_Double(BellH)->as<float>, 0.0, 0.0, Cos_Double(BellH)->as<float>);
    // Clocks for the live check (verify_e.py reads Clock1, the drives, then Clock2 in one observe)
    Clock1 = Pack_Double2(T, Sod);
    Clock2 = Pack_Double2(T, Sod);
}
