// Generated by modeling/p3_gimmicks/build_content.py (W10-C, G09 and G11). Do not edit by hand.
// Local presentation: every user evaluates the output Drives from the shared WorldTimeDouble and the
// HMC_P3 dynamic variables. No impulses and no synchronized writes.
module P3CandyStreet
out RodRotation: floatQ
out WitchPosition: float3
out WitchRotation: floatQ
out CarrierPosition: float3
out CarrierRotation: floatQ
out LiquidAlbedo: colorX
out LiquidEmissive: colorX
out BubblesRate: float
out BubblesStart: colorX
out BubblesEnd: colorX
out SmokeRate: float
out SmokeStart: colorX
out SmokeEnd: colorX
where {
    T = WorldTimeDouble;
    StirFrequencyIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G09StirFrequency");
    StirPhaseIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G09StirPhase");
    BubblesIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G09Bubbles");
    SmokeIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G09Smoke");
    ColorIn = DynamicVariableValueInput<colorX>(VariableName = "HMC_P3/G09LiquidColor");
    PatrolFrequencyIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G11Frequency");
    PatrolPhaseIn = DynamicVariableValueInput<float>(VariableName = "HMC_P3/G11Phase");
    // A missing variable reads as 0: the rod and the witch stay at their rest pose, no particles are emitted.
    // G09: stirring rod (Blender +Z = Resonite -Y) with a wobble about its local Z, twice per turn
    SF0 = StirFrequencyIn.Value;
    SF = if SF0 < 0.0 then 0.0 else if SF0 > 1.0 then 1.0 else SF0;
    SP = Clamp01_Float(StirPhaseIn.Value);
    Phi = (T * (SF->as<double>) + (SP->as<double>)) * 6.283185307179586d;
    WobHalf = 0.10471975511965978d * Sin_Double(Phi * 2.0d);
    SY = 0.0 - (Sin_Double(Phi * 0.5d)->as<float>);
    CY = Cos_Double(Phi * 0.5d)->as<float>;
    SZ = Sin_Double(WobHalf)->as<float>;
    CZ = Cos_Double(WobHalf)->as<float>;
    RodRotation = Pack_FloatQ(SY * SZ, SY * CZ, CY * SZ, CY * CZ);
    // G09: liquid colour (I02 writes HMC_P3/G09LiquidColor) and the particles
    Col = ColorIn.Value;
    LiquidAlbedo = ColorXSetAlpha(Col, 1.0);
    LiquidEmissive = ColorXSetAlpha(Mul_ColorX_Float(Col, 1.964626), 1.0);
    BubblesA0 = BubblesIn.Value;
    BubblesA = if BubblesA0 < 0.0 then 0.0 else if BubblesA0 > 2.0 then 2.0 else BubblesA0;
    BubblesRate = 6.0 * BubblesA;
    BubblesStart = ColorXSetAlpha(Mul_ColorX_Float(Col, 1.6), 0.9);
    BubblesEnd = ColorXSetAlpha(Mul_ColorX_Float(Col, 1.6), 0.6);
    SmokeA0 = SmokeIn.Value;
    SmokeA = if SmokeA0 < 0.0 then 0.0 else if SmokeA0 > 2.0 then 2.0 else SmokeA0;
    SmokeRate = 3.0 * SmokeA;
    SmokeStart = ColorXSetAlpha(Mul_ColorX_Float(Col, 1.1), 0.45);
    SmokeEnd = ColorXSetAlpha(Mul_ColorX_Float(Col, 1.1), 0.0);
    // G11: witch patrol on the trigonometric interpolation of the 8 waypoints (Blender x, y, z)
    PF0 = PatrolFrequencyIn.Value;
    PF = if PF0 < 0.0 then 0.0 else if PF0 > 0.1 then 0.1 else PF0;
    PP = Clamp01_Float(PatrolPhaseIn.Value);
    Th = (T * (PF->as<double>) + (PP->as<double>)) * 6.283185307179586d;
    C1 = Cos_Double(Th * 1.0d);
    S1 = Sin_Double(Th * 1.0d);
    C2 = Cos_Double(Th * 2.0d);
    S2 = Sin_Double(Th * 2.0d);
    C3 = Cos_Double(Th * 3.0d);
    S3 = Sin_Double(Th * 3.0d);
    C4 = Cos_Double(Th * 4.0d);
    S4 = Sin_Double(Th * 4.0d);
    Xb = (33.2125d + 9.271194077712556d * C1 + 0.4249999999999979d * C2 + 0.07880592228744146d * C3 + 0.21250000000000036d * C4)->as<float>;
    Yb = (10.053300858899107d * S1 + 0.5533008588991082d * S3)->as<float>;
    Zb0 = (10.25d + 0.24142135623730834d * C1 + -0.20000000000000084d * C2 + -0.0414213562373104d * C3 + -0.04999999999999982d * C4)->as<float>;
    Zb = if Zb0 < 9.8 then 9.8 else if Zb0 > 10.5 then 10.5 else Zb0;
    DX = -9.271194077712556d * S1 + -0.8499999999999958d * S2 + -0.23641776686232438d * S3 + -0.8500000000000014d * S4;
    DY = 10.053300858899107d * C1 + 1.6599025766973245d * C3;
    PsiHalf = Atan2_Double(DX, DY) * 0.5d;
    HeadingQ = Pack_FloatQ(0.0, Sin_Double(PsiHalf)->as<float>, 0.0, Cos_Double(PsiHalf)->as<float>);
    WitchPosition = Pack_Float3(Xb, Zb, Yb);
    WitchRotation = HeadingQ;
    CarrierPosition = Pack_Float3(Xb - 33.0, Zb - 0.0, Yb - 0.0);
    CarrierRotation = HeadingQ;
}
