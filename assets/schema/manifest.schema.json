{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usaturn/reso-world-Halloween/assets/schema/manifest.schema.json",
  "title": "Halloween Magical Carnival Asset Manifest",
  "description": "アセット一覧（assets/manifest/<key>.json および統合版 assets/manifest.json）のスキーマ定義（Spec §6.4 準拠）。",
  "type": "object",
  "required": [
    "schema_version",
    "key",
    "updated_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "key": {
      "type": "string",
      "enum": [
        "probe",
        "world",
        "common",
        "A_plaza",
        "B_mansion",
        "C_candy",
        "D_amusement",
        "E_forest",
        "overview",
        "meshy",
        "M01",
        "M02",
        "M03",
        "M04",
        "M05",
        "M06",
        "M07",
        "M08",
        "all"
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 10
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset_entry" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "vec3_positive": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 },
      "minItems": 3,
      "maxItems": 3
    },
    "id_string": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(_[A-Za-z0-9]+)+$"
    },
    "asset_entry": {
      "type": "object",
      "required": [
        "id",
        "area",
        "author_source",
        "file_and_version",
        "stage_status",
        "unit",
        "dimensions_m",
        "origin_and_facing",
        "placement",
        "parts",
        "motion",
        "attachment_points",
        "replacement_slot",
        "collider_policy",
        "material_and_textures",
        "metrics",
        "export_result",
        "verification_status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id_string" },
        "area": {
          "type": "string",
          "enum": ["P0", "W", "CMN", "A", "B", "C", "D", "E", "OVW", "MSH", "M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08"]
        },
        "author_source": {
          "type": "object",
          "required": ["author", "source_type", "meshy_id"],
          "properties": {
            "author": { "type": "string", "minLength": 1 },
            "source_type": {
              "type": "string",
              "enum": [
                "blender_procedural",
                "meshy_proxy",
                "meshy_final",
                "common_linked"
              ]
            },
            "meshy_id": {
              "type": ["string", "null"],
              "enum": ["M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08", null]
            }
          }
        },
        "file_and_version": {
          "type": "object",
          "required": ["blend_file", "script_file", "collection", "version"],
          "properties": {
            "blend_file": { "type": "string", "minLength": 1 },
            "script_file": { "type": "string", "minLength": 1 },
            "collection": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "stage_status": {
          "type": "string",
          "enum": ["proxy", "final", "verification_probe"]
        },
        "unit": {
          "type": "string",
          "const": "m"
        },
        "dimensions_m": { "$ref": "#/$defs/vec3_positive" },
        "origin_and_facing": {
          "type": "object",
          "required": ["origin_policy", "origin_local", "forward_axis", "up_axis"],
          "properties": {
            "origin_policy": {
              "type": "string",
              "enum": [
                "ground_center",
                "hinge",
                "rotation_center",
                "clock_axis",
                "motion_center",
                "world_origin"
              ]
            },
            "origin_local": { "$ref": "#/$defs/vec3" },
            "forward_axis": {
              "type": "string",
              "enum": ["-Y", "+Y", "+X", "-X"]
            },
            "up_axis": {
              "type": "string",
              "const": "+Z"
            }
          }
        },
        "placement": {
          "type": "object",
          "required": ["position", "rotation_euler_deg", "scale"],
          "properties": {
            "position": { "$ref": "#/$defs/vec3" },
            "rotation_euler_deg": { "$ref": "#/$defs/vec3" },
            "scale": { "$ref": "#/$defs/vec3" }
          }
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "parent", "role"],
            "properties": {
              "name": { "$ref": "#/$defs/id_string" },
              "parent": {
                "type": ["string", "null"]
              },
              "role": {
                "type": "string",
                "enum": [
                  "asset_root",
                  "motion_root",
                  "visual_root",
                  "attachment_point",
                  "fixed_collision",
                  "logic_root",
                  "static_part",
                  "movable_part"
                ]
              },
              "notes": { "type": "string" }
            }
          }
        },
        "motion": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "part_name",
              "gimmick_id",
              "motion_type",
              "pivot_local",
              "axis",
              "range",
              "rest_pose"
            ],
            "properties": {
              "part_name": { "$ref": "#/$defs/id_string" },
              "gimmick_id": { "type": ["string", "null"] },
              "motion_type": {
                "type": "string",
                "enum": [
                  "rotation",
                  "translation",
                  "oscillation",
                  "path_follow",
                  "scale_or_glow"
                ]
              },
              "pivot_local": { "$ref": "#/$defs/vec3" },
              "axis": {
                "oneOf": [
                  { "type": "string", "enum": ["X", "Y", "Z", "-X", "-Y", "-Z"] },
                  { "$ref": "#/$defs/vec3" }
                ]
              },
              "range": {
                "type": "object",
                "required": ["min", "max", "unit"],
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "unit": { "type": "string", "enum": ["deg", "m", "ratio"] }
                }
              },
              "rest_pose": {
                "type": "object",
                "required": ["position", "rotation_euler_deg"],
                "properties": {
                  "position": { "$ref": "#/$defs/vec3" },
                  "rotation_euler_deg": { "$ref": "#/$defs/vec3" }
                }
              },
              "notes": { "type": "string" }
            }
          }
        },
        "attachment_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "purpose", "local_position", "gimmick_or_interaction_id"],
            "properties": {
              "name": { "$ref": "#/$defs/id_string" },
              "purpose": { "type": "string", "minLength": 1 },
              "local_position": { "$ref": "#/$defs/vec3" },
              "gimmick_or_interaction_id": { "type": ["string", "null"] }
            }
          }
        },
        "replacement_slot": {
          "type": ["object", "null"],
          "required": [
            "meshy_id",
            "visual_root_part",
            "target_dimensions_m",
            "forward_axis",
            "keep_separate_parts"
          ],
          "properties": {
            "meshy_id": {
              "type": "string",
              "enum": ["M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08"]
            },
            "visual_root_part": { "$ref": "#/$defs/id_string" },
            "target_dimensions_m": { "$ref": "#/$defs/vec3_positive" },
            "forward_axis": {
              "type": "string",
              "enum": ["-Y", "+Y", "+X", "-X"]
            },
            "keep_separate_parts": {
              "type": "array",
              "items": { "$ref": "#/$defs/id_string" }
            }
          }
        },
        "collider_policy": {
          "type": "string",
          "enum": [
            "none",
            "box",
            "mesh_static",
            "convex_hull",
            "separate_fixed_collision"
          ]
        },
        "material_and_textures": {
          "type": "object",
          "required": ["materials", "textures"],
          "properties": {
            "materials": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "textures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "colorspace", "dimensions_px"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "colorspace": { "type": "string", "enum": ["sRGB", "Non-Color"] },
                  "dimensions_px": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": { "type": "integer", "minimum": 1 },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      { "type": "null" }
                    ]
                  }
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": ["measured", "triangles", "vertices", "materials"],
          "properties": {
            "measured": { "type": "boolean" },
            "triangles": { "type": ["integer", "null"], "minimum": 0 },
            "vertices": { "type": ["integer", "null"], "minimum": 0 },
            "materials": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "export_result": {
          "type": "object",
          "required": ["status", "bundle_path", "errors", "warnings"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["not_exported", "exported", "failed"]
            },
            "bundle_path": { "type": ["string", "null"] },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "verification_status": {
          "type": "object",
          "required": ["blender_checked", "resonite_checked", "notes"],
          "properties": {
            "blender_checked": { "type": "boolean" },
            "resonite_checked": {
              "type": "string",
              "enum": ["verified", "unverified", "not_applicable"]
            },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
